# ============================================================
# VARIABLES PARA RAILWAY (COPIAR Y PEGAR DIRECTO EN VARIABLES)
# Proyecto: SoftwareMotos Backend
# ============================================================

NODE_ENV=production
PORT=4000
APP_URL=https://softwaremotosbackend-production-9851.up.railway.app
FRONTEND_URL=https://software-motos.netlify.app

# Base de datos MySQL (Railway autogenera estas al vincular MySQL)
# No cambiar los nombres si ya están referenciados con ${{...}}
MYSQLHOST=${{RAILWAY_PRIVATE_DOMAIN}}
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=${{MYSQL_ROOT_PASSWORD}}
MYSQLDATABASE=railway
MYSQL_URL=mysql://${{MYSQLUSER}}:${{MYSQL_ROOT_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:3306/${{MYSQL_DATABASE}}

# También soportado por el backend
DB_HOST=${{RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=3306
DB_USER=root
DB_PASSWORD=${{MYSQL_ROOT_PASSWORD}}
DB_NAME=railway
DATABASE_URL=${{MYSQL_URL}}

# Autenticación y sesiones (GENERAR VALORES ÚNICOS EN PRODUCCIÓN)
SESSION_SECRET=cambiar_minimo_32_caracteres_aleatorios
JWT_ACCESS_SECRET=cambiar_secreto_jwt_acceso_aleatorio
JWT_REFRESH_SECRET=cambiar_secreto_jwt_refresh_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap primer admin (usar solo una vez desde POST /api/admin/bootstrap-admin)
ADMIN_BOOTSTRAP_TOKEN=

# Mercado Pago (configurar cuando esté listo)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Resend (configurar cuando esté listo)
RESEND_API_KEY=
EMAIL_FROM=no-reply@tudominio.com

# App
APP_NAME=Tu QR te Cuida

# Solo para migraciones manuales desde Railway Shell
ALLOW_PROD_SEED=false
