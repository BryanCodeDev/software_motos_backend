# ============================================================
# Variables de entorno — Identificación de Emergencia
# Copia este archivo a .env y completa los valores reales.
# Nunca subas credenciales reales al repositorio.
# ============================================================

# Entorno
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Base de datos MySQL (en Railway se proporcionan por el entorno)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=emergency_id

# Autenticación y sesiones (cambiar en producción)
SESSION_SECRET=cambiar_este_secreto_minimo_32_caracteres
JWT_ACCESS_SECRET=cambiar_secreto_de_acceso
JWT_REFRESH_SECRET=cambiar_secreto_de_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Token de un solo uso para crear el PRIMER administrador (bootstrapping seguro).
# Generar un valor aleatorio largo. Una vez creado el primer admin, este valor
# puede desactivarse.
ADMIN_BOOTSTRAP_TOKEN=cambiar_este_token_de_bootstrapping

# Mercado Pago (credenciales de prueba en desarrollo)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Resend (correos transaccionales — solo backend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@tu-dominio.com

# App
APP_NAME=Identificación de Emergencia
